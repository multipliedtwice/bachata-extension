{
  "version": 1,
  "id": "self-improvement-discovery",
  "name": "Internal — improvement discovery",
  "description": "Controller stage: two participants audit an exact checked-out candidate without edits. Requires a controller-supplied audit packet.",
  "longitudinalIntent": "runLocal",
  "agents": [
    {
      "id": "codex",
      "name": "Reviewer 1",
      "adapter": "codex-app-server",
      "command": "codex",
      "permissionMode": "readOnly",
      "approvalPolicy": "onRequest",
      "resourceId": "codex-cli:default-account"
    },
    {
      "id": "claude",
      "name": "Reviewer 2",
      "adapter": "claude-code",
      "command": "claude",
      "permissionMode": "plan",
      "resourceId": "claude-code:default-account"
    }
  ],
  "steps": [
    {
      "id": "independent-audit",
      "name": "Audit the candidate independently",
      "enabled": true,
      "type": "agent",
      "participants": [
        "codex",
        "claude"
      ],
      "promptTemplate": "{{userPrompt}}",
      "parallel": true,
      "consensus": false,
      "humanGate": "none",
      "permissionModes": {
        "codex": "readOnly",
        "claude": "plan"
      },
      "approvalPolicies": {
        "codex": "onRequest"
      },
      "attachments": "none",
      "output": {
        "name": "repositoryAudit",
        "format": "json",
        "shape": "repositoryAudit"
      }
    }
  ]
}
