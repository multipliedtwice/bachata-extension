{
  "version": 1,
  "id": "chatgpt-browser-spike",
  "name": "Browser task — one participant",
  "description": "One bound browser conversation completes the supplied task with approved local actions. The website selects the model.",
  "longitudinalIntent": "runLocal",
  "agents": [
    {
      "id": "chatgpt",
      "name": "Reviewer",
      "adapter": "chatgpt-browser"
    }
  ],
  "steps": [
    {
      "id": "browser-turn",
      "name": "Browser task",
      "enabled": true,
      "participants": [
        "chatgpt"
      ],
      "promptTemplate": "{{userPrompt}}",
      "parallel": false,
      "consensus": false,
      "humanGate": "after",
      "attachments": "selected",
      "type": "agent",
      "requiredCapabilities": [
        "browserSessionSelection",
        "passiveActionLoop"
      ]
    }
  ]
}
