{
  "version": 1,
  "id": "claude-browser-agent",
  "name": "Browser task — one participant (compatibility)",
  "description": "A single-browser workflow with a legacy default assignment. The website selects the model; local actions retain their approval rules.",
  "longitudinalIntent": "runLocal",
  "agents": [
    {
      "id": "claude-browser",
      "name": "Reviewer",
      "adapter": "claude-browser"
    }
  ],
  "steps": [
    {
      "id": "browser-turn",
      "name": "Browser task",
      "enabled": true,
      "participants": [
        "claude-browser"
      ],
      "promptTemplate": "{{userPrompt}}",
      "parallel": false,
      "consensus": false,
      "humanGate": "after",
      "attachments": "selected",
      "type": "agent",
      "requiredCapabilities": [
        "browserSessionSelection",
        "passiveActionLoop"
      ]
    }
  ]
}
