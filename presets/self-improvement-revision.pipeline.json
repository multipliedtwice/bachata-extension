{
  "version": 1,
  "id": "self-improvement-revision",
  "name": "Internal — improvement revision",
  "description": "Controller stage: apply one bounded revision to a rejected task. Requires the controller task packet and worktree.",
  "longitudinalIntent": "runLocal",
  "agents": [
    {
      "id": "claude",
      "name": "Reviewer",
      "adapter": "claude-code",
      "command": "claude",
      "permissionMode": "acceptEdits",
      "resourceId": "claude-code:default-account"
    }
  ],
  "steps": [
    {
      "id": "worker-revision",
      "name": "Worker revises the rejected candidate",
      "enabled": true,
      "participants": [
        "claude"
      ],
      "promptTemplate": "{{userPrompt}}",
      "parallel": false,
      "consensus": false,
      "humanGate": "none",
      "permissionModes": {
        "claude": "acceptEdits"
      },
      "attachments": "none",
      "type": "agent"
    }
  ]
}
