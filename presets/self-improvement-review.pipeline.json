{
  "version": 1,
  "id": "self-improvement-review",
  "name": "Internal — improvement review",
  "description": "Controller stage: review an exact task candidate and controller check results without edits. Requires the controller review packet.",
  "longitudinalIntent": "runLocal",
  "agents": [
    {
      "id": "codex",
      "name": "Reviewer",
      "adapter": "codex-app-server",
      "command": "codex",
      "permissionMode": "readOnly",
      "approvalPolicy": "onRequest",
      "resourceId": "codex-cli:default-account"
    }
  ],
  "steps": [
    {
      "id": "lead-review",
      "name": "Lead reviews the exact candidate",
      "enabled": true,
      "participants": [
        "codex"
      ],
      "promptTemplate": "{{userPrompt}}",
      "parallel": false,
      "consensus": false,
      "humanGate": "none",
      "permissionModes": {
        "codex": "readOnly"
      },
      "approvalPolicies": {
        "codex": "onRequest"
      },
      "attachments": "none",
      "type": "agent",
      "output": {
        "name": "taskReview",
        "format": "json",
        "shape": "taskReviewVerdict"
      }
    }
  ]
}
